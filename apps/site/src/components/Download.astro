---
import { t } from "../i18n";
import { RELEASED, downloadLink, RELEASES, REPOSITORY, VERSION, WEB_APP, type Locale } from "../site";

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = t(locale).download;
---
<section class="wrap page">
  <h1>{text.heading}</h1>
  <p class="lead">{text.intro}</p>
  {RELEASED ? (
    <div class="actions">
      <a class="button" href={downloadLink("mac", "download", locale)} data-platform="mac">{text.button}</a>
      <a class="button secondary" href={downloadLink("windows", "download", locale)} data-platform="windows">{text.buttonWindows}</a>
      <span class="version">{text.version} {VERSION}</span>
    </div>
  ) : (
    <>
      <p class="notice">{text.notYet}</p>
      <div class="actions"><a class="button secondary" href={`${REPOSITORY}#getting-started`}>{text.fromSource}</a></div>
    </>
  )}
  <div class="columns">
    <div>
      <h2>{text.requirementsTitle}</h2>
      <ul>{text.requirements.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div>
      <h2>{text.stepsTitle}</h2>
      <ol>
        <li>{text.install}
          <ul class="platforms">
            <li>{text.installMac}</li>
            <li>{text.installWindows}</li>
          </ul>
        </li>
        {text.steps.map((item) => <li>{item}</li>)}
      </ol>
      <p class="muted">{text.updates}</p>
    </div>
  </div>
  <p class="remote">{text.remote} <a href={WEB_APP} target="_blank" rel="noopener">{new URL(WEB_APP).host} ↗</a></p>
  <p><a href={RELEASES}>{text.allReleases} →</a></p>
</section>
<script>
  // Windows visitors get their installer as the primary button, listed first.
  if (/Windows/.test(navigator.userAgent)) {
    const mac = document.querySelector<HTMLElement>('[data-platform="mac"]');
    const windows = document.querySelector<HTMLElement>('[data-platform="windows"]');
    if (mac && windows) {
      mac.classList.add("secondary");
      windows.classList.remove("secondary");
      mac.before(windows);
    }
  }
</script>
<style>
  .page { padding-top: 72px; max-width: 900px; }
  h1 { font-size: clamp(40px, 6vw, 60px); }
  .remote { padding: 14px 18px; border-radius: 14px; background: var(--surface-subtle); color: var(--text-secondary); }
  .remote a { font-weight: 500; }
  .version { align-self: center; color: var(--text-secondary); font-size: 15px; }
  .columns { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin: 56px 0 32px; }
  h2 { font-size: 22px; margin-bottom: 12px; }
  li { margin: 8px 0; }
  .platforms { padding-left: 20px; color: var(--text-secondary); }
  .platforms li { margin: 4px 0; }
  .muted { color: var(--text-secondary); font-size: 15px; }
  @media (max-width: 720px) { .columns { grid-template-columns: 1fr; } }
</style>
