{
  "name": "ai-trade-helper-desktop",
  "version": "0.2.0",
  "description": "Local AI trading analysis application",
  "private": true,
  "author": "AI Trade Helper",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --dir"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aitradehelper.desktop",
    "productName": "AI Trade Helper",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "runtime.mjs",
      "locales.mjs",
      "themes.mjs",
      "release-info.mjs",
      "updater.mjs",
      "preload.cjs",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "build/update-policy.json",
        "to": "update-policy.json"
      },
      {
        "from": "../../version.json",
        "to": "version.json"
      },
      {
        "from": "../../CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "../../CHANGELOG.en.md",
        "to": "CHANGELOG.en.md"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dir"
      ],
      "identity": "-"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Finance"
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
