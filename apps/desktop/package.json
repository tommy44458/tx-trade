{
  "name": "ai-trade-helper-desktop",
  "version": "0.2.0",
  "description": "Local AI trading analysis application",
  "private": true,
  "author": "AI Trade Helper",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --dir"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aitradehelper.desktop",
    "productName": "AI Trade Helper",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["main.mjs", "runtime.mjs", "locales.mjs", "themes.mjs", "preload.cjs", "package.json", "node_modules/dotenv/**/*"],
    "extraResources": [
      { "from": "../web/dist", "to": "web" },
      { "from": "build/backend", "to": "backend" }
    ],
    "mac": { "category": "public.app-category.finance", "target": ["dir"], "identity": "-" },
    "linux": { "target": ["dir"], "category": "Finance" },
    "win": { "target": ["dir"] }
  }
}
