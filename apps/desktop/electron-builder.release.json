{
  "extends": "./electron-builder.base.cjs",
  "artifactName": "txinTrade-${version}-${os}-${arch}.${ext}",
  "forceCodeSigning": true,
  "generateUpdatesFilesForAllChannels": false,
  "publish": {
    "provider": "github",
    "owner": "tommy44458",
    "repo": "txin-trade",
    "channel": "latest",
    "releaseType": "draft"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64"] },
      { "target": "zip", "arch": ["arm64"] }
    ],
    "icon": "resources/icon.icns",
    "identity": "Developer ID Application",
    "type": "distribution",
    "hardenedRuntime": true,
    "strictVerify": true,
    "notarize": true,
    "binaries": ["Contents/Resources/backend/trade-helper-backend"]
  },
  "dmg": { "sign": true },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "resources/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "txinTrade"
  }
}
