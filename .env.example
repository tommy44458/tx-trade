# Copy this file to .env in the project root. Keep .env private.
# Browser development compatibility; desktop uses a private loopback API on a free port.
# Desktop: ./scripts/desktop.sh; authorize ChatGPT/Codex and enter optional keys in Settings.
APP_MODE=local
APP_LOCAL_USER_ID=local-demo
# Embedded SQLite is created automatically. No database server, URL or password.
# SQLite stores trading preferences, favorites, positions and public auth metadata.
# Desktop API keys and app ChatGPT tokens are AES-256-GCM encrypted in SQLite;
# the encryption master key is stored in the same local SQLite database, not Keychain.
# Treat the database and its backups as private, recoverable credential material.
# Legacy nonsecret JSON is imported once; re-enter legacy keys in Settings.
# Browser development: omit both overrides to use the project's data/ directory.
# Desktop always uses its private application data directory.
# APP_DATA_DIR=/absolute/path/to/tx-trade/data
# APP_DB_PATH=/absolute/path/to/tx-trade/data/trade_helper.sqlite3
# Legacy DATABASE_URL/APP_DB_SCHEMA are ignored during normal application use.
# PostgreSQL credentials are needed only by the explicit, read-only migration CLI.

# Only needed here for the legacy browser OpenAI API provider.
# Desktop API compatibility mode saves an optional key in encrypted SQLite via Settings;
# saving it does not select that provider and desktop never imports this environment key.
# Desktop ChatGPT/Codex providers do not need this key. Model failures are shown
# explicitly; a Python rules report is never passed off as an AI report.
OPENAI_API_KEY=
OPENAI_MODEL=

# Shared model analysis deadline (30..900 seconds); worker lease adds 120 seconds.
APP_ANALYSIS_TIMEOUT_SECONDS=240
# Codex reasoning effort for interactive reports; higher effort can take longer.
APP_CODEX_REASONING_EFFORT=medium

# Browser developer configuration; desktop Jev keys are saved in Settings.
# No desktop Jev key means no classification queueing or model requests.
# TypeSafe Jev classifies eligible official release bodies in the background.
# Classification remains unreviewed and is not yet strategy evidence.
# Broad crypto-news ingestion still requires a licensed provider.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Maximum Jev calls per UTC day, including failed attempts.
NEWS_JEV_DAILY_LIMIT=100

# Illustrative execution costs for strategy scenarios, in basis points per fill.
TRADE_SCENARIO_FEE_BPS=5
TRADE_SCENARIO_SLIPPAGE_BPS=2

# Browser developer configuration; desktop BingX keys are saved in Settings.
# BingX is optional; manual positions remain available without it.
# BingX read-only API key for importing current perpetual and standard futures positions.
# Create a read-only key in BingX, ideally with an IP allowlist. Never put it in VITE_*.
BINGX_API_KEY=
BINGX_API_SECRET=
# Optional read-only consensus source verification; not enabled as Agent evidence yet.
# Register at https://www.jblanked.com/register/ and obtain the key from Profile.
# Official changelog limits free use to 1 request/day. The CLI caches checks locally for 24h.
# Paste the key only; do not include the "Api-Key" prefix. No purchase is required for the probe.
JBLANKED_API_KEY=
# Desktop: enter this optional calendar key in Settings (encrypted SQLite), not .env.
# Public 1H/4H open interest context. No key required; 0 disables it.
TRADE_DERIVATIVES_CONTEXT_ENABLED=1
